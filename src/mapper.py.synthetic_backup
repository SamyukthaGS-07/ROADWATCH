#!/usr/bin/env python3
import sys
import csv

def norm(s):
    return (s or "").strip().lower().replace(" ", "_")

reader = csv.reader(sys.stdin)
header_seen = False
lat_idx = lon_idx = None

for row in reader:
    if not row:
        continue
    if not header_seen:
        names = [norm(x) for x in row]
        if "latitude" in names and "longitude" in names:
            lat_idx, lon_idx = names.index("latitude"), names.index("longitude")
            header_seen = True
            continue
        # Skip an unrecognized first row rather than accidentally parsing a header.
        header_seen = True
        continue
    try:
        lat = float(row[lat_idx])
        lon = float(row[lon_idx])
        if not (-90 <= lat <= 90 and -180 <= lon <= 180):
            continue
        # 0.01-degree cells are roughly 1.1 km north-south; east-west width varies by latitude.
        grid_lat = round(round(lat / 0.01) * 0.01, 2)
        grid_lon = round(round(lon / 0.01) * 0.01, 2)
        print(f"{grid_lat:.2f},{grid_lon:.2f}\t1")
    except (ValueError, IndexError, TypeError):
        continue
